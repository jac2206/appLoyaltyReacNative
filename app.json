{
  "expo": {
    "name": "loyalty-app",
    "slug": "loyalty-app",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/mugiwareLogo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/mugiwareLogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que Loyalty App use Face ID para iniciar sesión."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mugiwareLogo.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jac112206.loyaltyapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "4da12390-2cb8-4b0c-9c2d-3a74216ac3d3"
      }
    }
  }
}
